# Netlify response headers. Netlify consumes this file at deploy time; it is
# never served. Paths are matched top to bottom and a request collects the
# headers of every rule it matches.
#
# /media/* is the committed, versioned media that standalone pages embed
# (scripts/standalone-pages.js). Every filename carries a version, so a changed
# clip ships under a new name and no URL's bytes ever change: a year-long
# immutable cache is therefore safe, and a stale copy is impossible rather than
# merely unlikely. scripts/pre-render.js asserts this rule exists for as long as
# a standalone page references /media/, and that nothing in _redirects answers a
# /media/ path first.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# /downloads/* holds the printable worksheets (PDF), committed and versioned
# like /media/*: a changed file ships under a new -v name, so the immutable
# cache is safe. X-Robots-Tag keeps the PDFs out of search results, so the
# article that links them is what ranks. scripts/pre-render.js asserts these
# exact two values while downloads/ exists.
/downloads/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# /* adds three security headers to every path. nosniff stops a browser
# guessing a script or stylesheet out of a file served as something else; the
# referrer policy sends other sites the origin only, never a full path; the
# permissions policy turns off device features the site never uses.
# scripts/pre-render.js asserts the three exact values and that the /media/*
# rule above is unchanged.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
